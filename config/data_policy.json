{
  "schema_version": 1,
  "source_roots": ["iCloud", "texts"],
  "allowed_extensions": [".md", ".txt", ".json"],
  "excluded_path_fragments": [
    "Recently Deleted"
  ],
  "credential_filename_fragments": [
    "账号",
    "手机号",
    "银行卡",
    "bybit卡",
    "订阅"
  ],
  "ai_attribution_fragments": [
    "Claude",
    "Gemini",
    "Opus",
    "Kimi",
    "GPT"
  ],
  "authored_candidate_groups": [
    "biography",
    "machine_rules",
    "learning_essays",
    "daily_reflection"
  ],
  "sensitivity_patterns": {
    "email_like": "(?i)[a-z0-9._%+-]+@[a-z0-9.-]+\\.[a-z]{2,}",
    "mainland_phone_like": "(?<!\\d)1[3-9]\\d{9}(?!\\d)",
    "long_number_like": "(?<!\\d)\\d{15,19}(?!\\d)",
    "secret_assignment_like": "(?i)(password|passwd|api[_ -]?key|access[_ -]?token|secret)\\s*[:=]"
  }
}
