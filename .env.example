# Copy to .env locally. Never commit real credentials.
DIGITAL_MIRROR_ACCESS_PASSWORD=replace-with-a-long-password
DIGITAL_MIRROR_SESSION_SECRET=replace-with-a-random-session-secret

# Google Gemini
GEMINI_API_KEY=
DIGITAL_MIRROR_GEMINI_MODEL=gemini-2.5-flash

# DeepSeek
DEEPSEEK_API_KEY=
DIGITAL_MIRROR_DEEPSEEK_MODEL=deepseek-chat

# OpenAI (model is explicit so the project never silently changes it)
OPENAI_API_KEY=
DIGITAL_MIRROR_OPENAI_MODEL=
DIGITAL_MIRROR_OPENAI_BASE_URL=https://api.openai.com/v1

# Any provider exposing an OpenAI-compatible chat-completions endpoint
DIGITAL_MIRROR_COMPATIBLE_API_KEY=
DIGITAL_MIRROR_COMPATIBLE_BASE_URL=
DIGITAL_MIRROR_COMPATIBLE_MODEL=

# Local Ollama
DIGITAL_MIRROR_OLLAMA_URL=http://127.0.0.1:11434
DIGITAL_MIRROR_OLLAMA_MODEL=
