{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.digital-mirror/schemas/replay_prediction.schema.json",
  "title": "Digital Mirror Replay Prediction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "episode_id",
    "predicted_judgement",
    "predicted_action",
    "option_probabilities",
    "considered_option_ids",
    "tensions",
    "unknowns",
    "deliberation_intensity",
    "confidence",
    "evidence_ids"
  ],
  "properties": {
    "episode_id": {"type": "string"},
    "predicted_judgement": {"type": "string"},
    "predicted_action": {"type": "string"},
    "option_probabilities": {
      "type": "object",
      "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "considered_option_ids": {"type": "array", "items": {"type": "string"}},
    "tensions": {"type": "array", "items": {"type": "string"}},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "deliberation_intensity": {"type": "number", "minimum": 0, "maximum": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence_ids": {"type": "array", "items": {"type": "string"}}
  }
}
